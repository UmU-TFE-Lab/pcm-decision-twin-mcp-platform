# Frontend
VITE_API_BASE_URL=https://api.example.com
VITE_MCP_GATEWAY_URL=https://mcp.example.com

# MCP Gateway
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8787
MCP_GATEWAY_CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173
PCM_DATASET_PATH=/app/pcm_thermal_storage.csv

# Backend
APP_NAME=PCM Digital Twin API
CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173
POSTGRES_DB=pcm_twin
POSTGRES_USER=pcm
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+psycopg://pcm:replace-with-a-database-password@postgres:5432/pcm_twin
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=pcm-digital-twin
ACCESS_TOKEN_MINUTES=480
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# S3 or S3-compatible object storage
MINIO_ROOT_USER=replace-with-a-storage-user
MINIO_ROOT_PASSWORD=replace-with-a-storage-password
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=pcm-datasets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Model service
MODEL_SERVICE_URL=https://model.example.com
LOCAL_DATASET_PATH=/pcm_thermal_storage.csv
