{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCM thermal-storage scenario record",
  "type": "object",
  "required": [
    "timestamp",
    "pcm_type",
    "system_type",
    "encapsulation_type",
    "air_temperature_c",
    "relative_humidity_pct",
    "wind_speed_mps",
    "cloud_cover_pct",
    "solar_irradiance_wm2",
    "inlet_fluid_temp_c",
    "melting_point_c",
    "latent_heat_kjkg",
    "thermal_conductivity_wmk",
    "density_kgm3",
    "specific_heat_jkgk",
    "pcm_mass_kg",
    "surface_area_m2",
    "pcm_thickness_mm",
    "mass_flow_rate_kgs",
    "cycle_number",
    "degradation_factor",
    "temp_difference_c",
    "phase_fraction",
    "heat_transfer_coeff_wm2k",
    "heat_flux_wm2",
    "stored_energy_kj",
    "energy_input_kj",
    "charging_time_min",
    "discharging_time_min",
    "energy_loss_pct",
    "state_of_charge_pct",
    "cooling_load_offset_pct",
    "thermal_storage_efficiency_pct"
  ],
  "properties": {
    "timestamp": { "type": "string" },
    "pcm_type": { "enum": ["Organic_Paraffin", "Inorganic_SaltHydrate", "Eutectic"] },
    "system_type": { "enum": ["BuildingEnvelope", "SolarTES", "BatteryCooling", "HVACStorage"] },
    "encapsulation_type": { "enum": ["Macro", "Micro", "ShapeStabilized"] },
    "air_temperature_c": { "type": "number" },
    "relative_humidity_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "wind_speed_mps": { "type": "number", "minimum": 0 },
    "cloud_cover_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "solar_irradiance_wm2": { "type": "number", "minimum": 0 },
    "inlet_fluid_temp_c": { "type": "number" },
    "melting_point_c": { "type": "number" },
    "latent_heat_kjkg": { "type": "number", "exclusiveMinimum": 0 },
    "thermal_conductivity_wmk": { "type": "number", "exclusiveMinimum": 0 },
    "density_kgm3": { "type": "number", "exclusiveMinimum": 0 },
    "specific_heat_jkgk": { "type": "number", "exclusiveMinimum": 0 },
    "pcm_mass_kg": { "type": "number", "exclusiveMinimum": 0 },
    "surface_area_m2": { "type": "number", "exclusiveMinimum": 0 },
    "pcm_thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
    "mass_flow_rate_kgs": { "type": "number", "minimum": 0 },
    "cycle_number": { "type": "integer", "minimum": 0 },
    "degradation_factor": { "type": "number", "minimum": 0.82, "maximum": 1.02 },
    "temp_difference_c": { "type": "number" },
    "phase_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "heat_transfer_coeff_wm2k": { "type": "number", "minimum": 0 },
    "heat_flux_wm2": { "type": "number", "minimum": -500, "description": "Signed heat-flux density; negative values denote the opposite reference direction." },
    "stored_energy_kj": { "type": "number", "minimum": 0 },
    "energy_input_kj": { "type": "number", "minimum": 0 },
    "charging_time_min": { "type": "number", "minimum": 0 },
    "discharging_time_min": { "type": "number", "minimum": 0 },
    "energy_loss_pct": { "type": "number", "minimum": 2, "maximum": 35 },
    "state_of_charge_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "cooling_load_offset_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "thermal_storage_efficiency_pct": { "type": "number", "minimum": 35, "maximum": 98 }
  },
  "additionalProperties": false
}
