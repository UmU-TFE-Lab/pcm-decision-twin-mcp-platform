{
  "name": "pcm-decision-twin-mcp-agent-platform",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmU-TFE-Lab/pcm-decision-twin-mcp-platform.git"
  },
  "bugs": {
    "url": "https://github.com/UmU-TFE-Lab/pcm-decision-twin-mcp-platform/issues"
  },
  "homepage": "https://github.com/UmU-TFE-Lab/pcm-decision-twin-mcp-platform#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "mcp": "node mcp_server/server.mjs",
    "gateway": "node mcp_gateway/server.mjs",
    "mcp:smoke": "node mcp_server/smokeTest.mjs",
    "mcp:benchmark": "node mcp_server/agentBenchmark.mjs",
    "platform:performance": "node scripts/platform_performance.mjs",
    "data:validate": "node scripts/validate_dataset.mjs",
    "data:stage": "node scripts/stage_dataset.mjs",
    "test:fixture": "node scripts/generate_test_dataset.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:services": ".venv/bin/python scripts/test_python_services.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "nanoid": "3.3.18",
    "qs": "6.16.0"
  }
}
